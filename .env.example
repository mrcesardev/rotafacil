# Porta do servidor
PORT=3000

# Banco PostgreSQL (as migrações rodam sozinhas ao iniciar)
DATABASE_URL=postgres://rotafacil:rotafacil@localhost:5432/rotafacil
# Senha do PostgreSQL no docker-compose (troque!)
# POSTGRES_PASSWORD=uma-senha-forte
# Testes usam um schema temporário neste banco:
# TEST_DATABASE_URL=postgres://rotafacil:rotafacil@localhost:5432/rotafacil

# Roteamento por ruas reais (OSRM) e otimizador VROOM.
# Sem eles o sistema funciona com distâncias estimadas e otimizador embutido.
# (No docker-compose já vêm configurados.)
# OSRM_URL=http://localhost:5000
# VROOM_URL=http://localhost:3001

# Estimativa sem OSRM: fator de desvio das ruas e velocidade média urbana
# DETOUR_FACTOR=1.35
# FALLBACK_SPEED_KMH=25

# Geocodificação de endereços em texto (Nominatim/OpenStreetMap).
# O servidor público aceita no máximo 1 req/s e não permite uso pesado: em produção,
# hospede o seu (https://nominatim.org) e aponte aqui. GEOCODING=off desliga.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODE_COUNTRY=br

# Tiles do mapa. O servidor do OSM não permite uso comercial intenso:
# em produção use um provedor (MapTiler, Stadia, Protomaps) ou hospede os seus.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; colaboradores do OpenStreetMap

# Camada de satélite opcional (ex.: MapTiler satellite com sua chave)
# SATELLITE_TILE_URL=https://api.maptiler.com/maps/satellite/{z}/{x}/{y}.jpg?key=SUA_CHAVE
# SATELLITE_ATTRIBUTION=&copy; MapTiler &copy; colaboradores do OpenStreetMap

# Atrás de proxy reverso (Caddy/Nginx): usa o IP real do cliente no limite de tentativas
# TRUST_PROXY=1

# WhatsApp Cloud API (oficial da Meta) — recebimento automático de localizações
# WHATSAPP_VERIFY_TOKEN=um-texto-secreto-qualquer
# WHATSAPP_APP_SECRET=segredo-do-app-na-meta
